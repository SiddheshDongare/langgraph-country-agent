# Copy this file to .env and fill in your values.

COUNTRY_AGENT_OPENAI_API_KEY=your_api_key_here

# REST Countries v5 key — https://restcountries.com (v3.1 is deprecated)
COUNTRY_AGENT_API_KEY=your_restcountries_key_here

